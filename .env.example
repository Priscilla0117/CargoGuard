# Learned email routing, strict comparison and local OCR do not need an API key.
# Independent deployment: create a Turso libSQL database on the Free plan.
# Put real credentials in the host's secret environment settings, never Git.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-private-database-token
# Only for local development/QA (never on Render):
# CARGO_LOCAL_DB=work/local.db

# Optional OpenAI evidence recovery. Set these ONLY in Render's secret settings.
# Keep disabled until the owner approves external processing and API charges.
# The browser never receives the key. Do not prefix it with NEXT_PUBLIC_.
# CARGO_AI_PROVIDER=openai
# CARGO_AI_MODEL=gpt-5.4-mini
# CARGO_AI_API_KEY=your-restricted-project-api-key
# Application caps: 50 attempts/day globally, 100 lifetime, 10/workspace/day.
# Reserved-token bounds: 500,000/day; original 1,000,000 lifetime remains.
# Additional input/output and concurrency caps may stop calls sooner.
# Removing CARGO_AI_PROVIDER disables new external requests; manual review remains.

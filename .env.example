# Learned email routing, strict comparison and local OCR do not need an API key.
# Independent deployment: create a Turso libSQL database on the Free plan.
# Put real credentials in the host's secret environment settings, never Git.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-private-database-token
# Only for local development/QA (never on Render):
# CARGO_LOCAL_DB=work/local.db

# Optional OpenAI evidence recovery. Set these ONLY in Render's secret settings.
# Keep disabled until the owner approves external processing and API charges.
# The browser never receives the key. Do not prefix it with NEXT_PUBLIC_.
# CARGO_AI_PROVIDER=openai
# CARGO_AI_MODEL=gpt-5.4-mini
# CARGO_AI_API_KEY=your-restricted-project-api-key
# Application caps: 50 attempts/day globally, 100 lifetime, 10/workspace/day.
# Reserved-token bounds: 500,000/day; original 1,000,000 lifetime remains.
# Additional input/output and concurrency caps may stop calls sooner.
# Removing CARGO_AI_PROVIDER disables new external requests; manual review remains.

# Authentication defaults to demo. See docs/TEAM_ACCESS.md before team setup.
# CARGO_AUTH_MODE=demo
# CARGO_AUTH_MODE=team
# Employee team workspaces start empty. Only enable sample data for training.
# CARGO_INCLUDE_SAMPLE_DATA=false
# Import capacity is enforced atomically (demo default 30; team default 1000).
# Choose 1–10000 based on storage/operational capacity; it does not enlarge storage.
# CARGO_MAX_WORKSPACE_UPLOADS=1000
# CARGO_PUBLIC_ORIGIN=https://your-host
# For initial team setup only: generate a cryptographically random secret of
# at least 32 characters in the server secret store. Never commit its real value.
# Remove the bootstrap secret after completing administrator registration.
# CARGO_BOOTSTRAP_SECRET=your-private-random-bootstrap-secret

# Optional Microsoft adapter: no tenant/application is provisioned by this repo.
# See docs/MICROSOFT_SETUP.md. Requires authenticated team mode and tenant consent.
# Keep all credentials in the server secret store; never use NEXT_PUBLIC_ names.
# CARGO_MS_TENANT_ID=your-tenant-guid
# CARGO_MS_CLIENT_ID=your-confidential-web-app-guid
# CARGO_MS_CLIENT_SECRET=your-private-application-secret
# CARGO_MS_REDIRECT_URI=https://your-host/api/microsoft/callback
# Base64-encode a securely generated 32-byte AES key; retain it for token decryption.
# CARGO_MS_TOKEN_KEY=your-private-base64-encoded-32-byte-key
# Sending and Outlook framing stay disabled unless explicitly configured.
# CARGO_MS_ALLOW_SEND=false
# CARGO_MS_ADDIN_ENABLED=false
# CARGO_MS_ADDIN_ID=your-stable-outlook-addin-guid
# Optional reviewed deadline email dispatch; disabled with no approved recipients.
# CARGO_MS_ALERTS_ENABLED=false
# CARGO_MS_ALERT_RECIPIENTS=approved-operations-recipient@example.com

# Gmail / mailbox connection (see docs/GMAIL_SETUP.md). Required for any mailbox:
# a random base64 32-byte key that encrypts saved mailbox logins. Local demo
# mode creates work/.mail-token-key automatically when this is unset.
# CARGO_MAIL_TOKEN_KEY=your-private-base64-encoded-32-byte-key
# Option A: Sign in with Google (redirect URI: <CARGO_PUBLIC_ORIGIN>/api/mail/callback)
# CARGO_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# CARGO_GOOGLE_CLIENT_SECRET=your-private-client-secret
# Option B: email + app password over IMAP/SMTP (Gmail, Outlook.com, Yahoo presets)
# CARGO_MAIL_IMAP_ENABLED=true
# Optional company mail server for option B (only this host can be contacted)
# CARGO_MAIL_IMAP_HOST=imap.company.example
# CARGO_MAIL_SMTP_HOST=smtp.company.example
# Replies can always be saved as drafts; set false to also forbid sending.
# CARGO_MAIL_ALLOW_SEND=true
# Optional AI wording help for replies (facts are protected; consent per use)
# CARGO_REPLY_AI_PROVIDER=anthropic
# CARGO_REPLY_AI_API_KEY=your-restricted-api-key
# CARGO_REPLY_AI_MODEL=claude-sonnet-5

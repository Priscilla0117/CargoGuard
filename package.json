{
  "name": "cargoguard-averis",
  "version": "3.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --webpack",
    "build": "node scripts/stage-ocr.mjs && next build --webpack",
    "start": "node scripts/start-node.mjs",
    "build:workers": "node scripts/run-framework.mjs build",
    "dev:workers": "node scripts/run-framework.mjs dev",
    "db:migrate": "node --import tsx scripts/migrate-node.ts",
    "test:governance": "node scripts/test-governance-api.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:hardening": "node scripts/test-hardening-api.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "typecheck": "tsc --noEmit",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "db:local": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.local.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.2.108",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "6.0.1",
    "tsx": "^4.23.13",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "ws": "8.21.0",
    "vinext": {
      "image-size": "2.0.3"
    },
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.0"
    }
  }
}
